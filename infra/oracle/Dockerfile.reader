# syntax=docker/dockerfile:1.7
# HiveForYou V4 Reader — ARM64-compatible image (Oracle host).
# Packages unmodified V3 `hive_reader` + V4 `v4_reader_wrapper.py`.
# LiteLLM OCR / AI extraction remain disabled at runtime (see v4_reader_wrapper.py).

ARG PYTHON_IMAGE=python:3.12-slim-bookworm

# ---------------------------------------------------------------------------
# Optional: fetch V3 apps/reader from an approved Git revision (no local V3 tree).
# Build with: --target runtime-git --build-arg FETCH_V3_FROM_GIT=1 ...
# ---------------------------------------------------------------------------
FROM ${PYTHON_IMAGE} AS v3_git_fetch
ARG FETCH_V3_FROM_GIT=0
ARG HIVE_READER_V3_GIT_URL=
ARG HIVE_READER_V3_GIT_REF=
RUN if [ "$FETCH_V3_FROM_GIT" != "1" ]; then mkdir -p /opt/hive_reader && exit 0; fi; \
    if [ -z "$HIVE_READER_V3_GIT_URL" ] || [ -z "$HIVE_READER_V3_GIT_REF" ]; then \
      echo "HIVE_READER_V3_GIT_URL and HIVE_READER_V3_GIT_REF are required when FETCH_V3_FROM_GIT=1" >&2; \
      exit 1; \
    fi; \
    apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/* \
    && git clone --filter=blob:none --no-checkout "$HIVE_READER_V3_GIT_URL" /tmp/v3repo \
    && cd /tmp/v3repo \
    && git checkout "$HIVE_READER_V3_GIT_REF" -- apps/reader \
    && mv apps/reader /opt/hive_reader \
    && rm -rf /tmp/v3repo

# ---------------------------------------------------------------------------
# Runtime base (shared)
# ---------------------------------------------------------------------------
FROM ${PYTHON_IMAGE} AS runtime_base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates \
      tesseract-ocr \
      tesseract-ocr-eng \
      libreoffice-writer \
      libreoffice-common \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 --shell /usr/sbin/nologin hiveforyou

WORKDIR /app

RUN pip install \
    'fastapi>=0.115,<1' \
    'uvicorn[standard]>=0.32,<1' \
    'pydantic>=2,<3' \
    'pydantic-settings>=2,<3' \
    'httpx>=0.27,<1' \
    'pymupdf>=1.24,<2' \
    'pillow>=10,<12' \
    'pytesseract>=0.3,<1'

COPY v4_reader_wrapper.py /app/v4_reader_wrapper.py

ENV PYTHONPATH=/opt/hive_reader/src:/app \
    READER_LIBREOFFICE_BINARY=soffice

EXPOSE 8082

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8082/health', timeout=3)"

CMD ["uvicorn", "v4_reader_wrapper:app", "--host", "0.0.0.0", "--port", "8082", "--no-access-log"]

# ---------------------------------------------------------------------------
# Target: runtime-local — V3 tree supplied via BuildKit context `v3_reader`
# (path must be hiveforyou-v3/apps/reader).
# ---------------------------------------------------------------------------
FROM runtime_base AS runtime-local
COPY --from=v3_reader . /opt/hive_reader/
RUN chown -R hiveforyou:hiveforyou /opt/hive_reader
USER hiveforyou

# ---------------------------------------------------------------------------
# Target: runtime-git — V3 tree from v3_git_fetch stage
# ---------------------------------------------------------------------------
FROM runtime_base AS runtime-git
COPY --from=v3_git_fetch /opt/hive_reader /opt/hive_reader/
RUN chown -R hiveforyou:hiveforyou /opt/hive_reader
USER hiveforyou

# Default image target for `docker build` without --target
FROM runtime-local AS runtime
