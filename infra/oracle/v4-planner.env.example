# HiveForYou V4 Planner (D-039). Copy to v4-planner.env (gitignored), chmod 600.
# Never commit real values; never reuse the LiteLLM master key or the Reader token.

# Bearer token the web server sends (Vercel PLANNER_SERVICE_TOKEN). Distinct from READER_SERVICE_TOKEN.
PLANNER_SERVICE_TOKEN=

# Private LiteLLM gateway on the oracle_default Docker network. Never proxied publicly.
PLANNER_LITELLM_BASE_URL=http://hive-litellm:4000

# Scoped LiteLLM virtual key limited to the `sorter`, `heavy_lifter` and `harvester` models (not the master key).
PLANNER_LITELLM_API_KEY=

# Fixed preparation alias (intent, domain, intelligence, plan). Callers cannot override it.
PLANNER_LITELLM_ALIAS=sorter

# Canonical Study and Writer aliases (D-041). Required: unset fails closed (MODEL_UNAVAILABLE).
PLANNER_STUDY_LITELLM_ALIAS=heavy_lifter
PLANNER_WRITER_LITELLM_ALIAS=harvester

# Canonical Study structured output (off by default). Set to json_schema after live compatibility check
# on heavy_lifter (Claude Opus 4.6). When enabled, the planner sends LiteLLM response_format json_schema
# with a compact provider projection of hive.study-investigation/1 (no value constraints, shallow formula)
# and fails closed if the gateway rejects it. Trusted verification still enforces the full contract.
# PLANNER_STUDY_STRUCTURED_OUTPUT=json_schema
