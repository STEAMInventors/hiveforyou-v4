# HiveForYou V4 Planner (D-039). Copy to v4-planner.env (gitignored), chmod 600.
# Never commit real values; never reuse the LiteLLM master key or the Reader token.

# Bearer token the web server sends (Vercel PLANNER_SERVICE_TOKEN). Distinct from READER_SERVICE_TOKEN.
PLANNER_SERVICE_TOKEN=

# Private LiteLLM gateway on the oracle_default Docker network. Never proxied publicly.
PLANNER_LITELLM_BASE_URL=http://hive-litellm:4000

# Scoped LiteLLM virtual key limited to the `sorter`, `heavy_lifter` and `harvester` models (not the master key).
PLANNER_LITELLM_API_KEY=

# Fixed preparation alias (intent, domain, intelligence, plan). Callers cannot override it.
PLANNER_LITELLM_ALIAS=sorter

# Study-agent turn (D-042) and Writer aliases (D-041). Required: unset fails closed (MODEL_UNAVAILABLE).
# The Study alias relays native tool-calling turns only; the planner never executes Study tools.
PLANNER_STUDY_LITELLM_ALIAS=heavy_lifter
PLANNER_WRITER_LITELLM_ALIAS=harvester

# Tool-free pipeline completions on /v1/plan-completion. Required: unset fails closed (MODEL_UNAVAILABLE).
# canonicalize stays on this alias for unpinned Hives. Pinned mapping uses the study alias above.
PLANNER_EXTRACT_LITELLM_ALIAS=harvester
PLANNER_CANONICALIZE_LITELLM_ALIAS=heavy_lifter
PLANNER_WRITE_LITELLM_ALIAS=harvester

# Not a route (D-063). Pinned mapping is study-agent-turn task "mapping" on PLANNER_STUDY_LITELLM_ALIAS.
# Leave this unset. /health still reports it when present.
# PLANNER_FIELD_MAPPING_LITELLM_ALIAS=

# External mapping allowlist (D-064). Comma-separated Hive UUIDs. Empty refuses every external post.
# Put only the one invented-data Hive here. content_class and a client synthetic flag are not read.
# PLANNER_EXTERNAL_MAPPING_HIVE_IDS=

# Hive conversation assistant replies on synthetic hives (`assistant_reply` on /v1/plan-completion). Sonnet-class; short grounded replies.
PLANNER_ASSISTANT_LITELLM_ALIAS=harvester

# In-process async completions (`POST /v1/jobs`, `GET /v1/jobs/{job_id}`). Optional worker pool size (default 4).
# PLANNER_JOB_WORKERS=4

# Web (Vercel): comma list `PLANNER_ASYNC_JOBS_TASKS=canonicalize` — only listed pipeline tasks use `/v1/jobs`; unset = all sync. Keep `extract` off until per-range jobId persistence across hand-offs is wired.
