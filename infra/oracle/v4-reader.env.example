# Non-secret V4 Reader defaults (Oracle host: /etc/hiveforyou/v4-reader.env).
# Separate process, port, service token, and V4 Supabase project from V3 Reader.
READER_GIT_SHA=
READER_MAX_PAGES_DEFAULT=500
READER_HTTP_TIMEOUT_SECONDS=120

# V4 Supabase project URL and secret/service_role key (must NOT point at V3 Supabase).
READER_SUPABASE_URL=
READER_SUPABASE_SERVICE_ROLE_KEY=

# Distinct V4 Bearer token shared only between V4 web server and V4 Reader process.
READER_SERVICE_TOKEN=

# Headless LibreOffice DOCX -> PDF (reproducible_v1).
READER_LIBREOFFICE_BINARY=soffice
READER_LIBREOFFICE_VERSION_PIN=7.6.7.2
READER_LIBREOFFICE_RENDER_TIMEOUT_SECONDS=120

# LiteLLM OCR and reasoning MUST remain unset/empty for V4 Step 1.
# LITELLM_BASE_URL=
# LITELLM_API_KEY=
# READER_OCR_LITELLM_ALIAS=
# READER_P2_REASONING_LITELLM_ALIAS=
