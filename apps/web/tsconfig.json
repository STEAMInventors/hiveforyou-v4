{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@hives/contracts": ["./src/server/source-documents/v3-vault/contracts/index.ts"],
      "@hives/core": ["./src/server/source-documents/v3-vault/core/index.ts"],
      "@hives/security": ["./src/server/source-documents/v3-vault/security/index.ts"],
      "@hives/persistence/vault/*": ["./src/server/source-documents/v3-vault/persistence/vault/*"],
      "@hives/persistence/storage/*": ["./src/server/source-documents/v3-vault/persistence/storage/*"],
      "@hives/persistence/env": ["./src/server/source-documents/v3-vault/persistence/env.ts"],
      "server-only": ["./src/lib/server/server-only.ts"]
    },
    "allowJs": true,
    "incremental": true,
    "noEmit": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
