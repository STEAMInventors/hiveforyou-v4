  "stage4bPlan": {
    "gate": "Stage 4B executable rules",
    "startsOnlyAfter": "Founder review of Stage 4A. This gate does not activate rules.",
    "steps": [
      {
        "id": "4B-1",
        "action": "Activate only the seven DAYS_BETWEEN calculations as day counts.",
        "calculationIds": [
          "calculation:C1",
          "calculation:C2",
          "calculation:C3",
          "calculation:C14",
          "calculation:C15",
          "calculation:C20",
          "calculation:C21"
        ],
        "change": "Set state from DECLARATION_ONLY to EXECUTABLE and attach the requiredBindings recorded here, unchanged.",
        "result": "DP-2 may return COMPUTED integer day counts. A day count is not a compliance verdict.",
        "doNot": [
          "Do not add a numeric threshold.",
          "Do not set applicability.verification to REVIEWED.",
          "Do not store a state timeframe, consent rule, SLD method, or age of majority.",
          "Do not execute DIFFERENCE, RATE_PER_WEEK, SUM_BY, ADD_INTERVAL, or REFERENCE_GAP."
        ]
      },
      {
        "id": "4B-2",
        "action": "Leave every check at REVIEW_REQUIRED.",
        "reason": "DP-2 establishes a deadline comparison only when the literal names a jurisdiction, the pack applicability names that same jurisdiction, and verification is REVIEWED. Legal authorities are NOT_REVIEWED. check:T2, check:T3, and check:RA1 therefore stay review questions beside C1, C2, and C14."
      },
      {
        "id": "4B-3",
        "action": "Do not add EVERY, EXISTS, conflictPattern, stateOverlay, or factClasses to DP-1.",
        "reason": "Those constructs stay in the versioned specifications written in Stage 4A."
