{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hive.writer-report/1",
  "title": "HiveForYou Writer report (untrusted until validated against the Canonical Study)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "audience", "title", "summary", "sections", "scenarios", "view"],
  "properties": {
    "schema": { "const": "hive.writer-report/1" },
    "audience": { "enum": ["CUSTOMER", "PRO"] },
    "title": { "type": "string", "maxLength": 160 },
    "summary": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/block" } },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "heading", "blocks"],
        "properties": {
          "id": { "type": "string", "pattern": "^s[1-9][0-9]?$" },
          "heading": { "type": "string", "maxLength": 160 },
          "blocks": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/block" } }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "question", "rationale", "claimRefs", "parameters", "results"],
        "properties": {
          "id": { "type": "string", "pattern": "^S[1-9]$" },
          "title": { "type": "string", "maxLength": 160 },
          "question": { "type": "string", "maxLength": 600 },
          "rationale": { "type": "string", "maxLength": 1200 },
          "claimRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/claimId" } },
          "parameters": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "label", "value", "unit", "basis", "claimRef"],
              "properties": {
                "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]{0,31}$" },
                "label": { "type": "string", "maxLength": 200 },
                "value": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$" },
                "unit": { "type": ["string", "null"], "maxLength": 40 },
                "basis": { "enum": ["DOCUMENTED", "ASSUMPTION"] },
                "claimRef": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/claimId" }] }
              }
            }
          },
          "results": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "unit", "formula"],
              "properties": {
                "id": { "type": "string", "pattern": "^R[1-9]$" },
                "label": { "type": "string", "maxLength": 200 },
                "unit": { "type": ["string", "null"], "maxLength": 40 },
                "formula": { "$ref": "#/$defs/formula" }
              }
            }
          }
        }
      }
    },
    "view": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "props"],
        "properties": {
          "component": {
            "enum": [
              "Narrative",
              "KeyFindings",
              "Metric",
              "RecordTable",
              "Comparison",
              "Timeline",
              "IssueList",
              "QuestionList",
              "EvidencePanel",
              "Chart",
              "Checklist",
              "ScenarioExplorer",
              "SourceReferences"
            ]
          },
          "props": { "type": "object" }
        }
      }
    }
  },
  "$defs": {
    "claimId": { "type": "string", "pattern": "^P[1-9][0-9]{0,2}(\\.[FCAUKDL][0-9]{1,3})?$" },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text", "claimRefs"],
      "properties": {
        "type": { "enum": ["DOCUMENTED", "INTERPRETATION", "UNCERTAINTY", "GENERAL_INFORMATION", "QUESTION", "NEXT_STEP"] },
        "text": { "type": "string", "maxLength": 2000 },
        "claimRefs": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/claimId" } }
      }
    },
    "formula": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["param"], "properties": { "param": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["ref"], "properties": { "ref": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["value"], "properties": { "value": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$" } } },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "args"],
          "properties": {
            "op": { "enum": ["+", "-", "*", "/", "min", "max", "round"] },
            "args": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/formula" } },
            "places": { "type": "integer", "minimum": 0, "maximum": 6 }
          }
        }
      ]
    }
  }
}
